<!DOCTYPE html>
<html lang="en">
<head>
    <title>CSS Layout Techniques</title>

<style>
    body {
        font-family: Arial, sans-serif;
        margin: 0;
        background-color: #334086;
    }

    h1, h2 {
        text-align: center;
    }

    section {
        background-color: #7087d0;
        margin: 20px;
        padding: 20px;
    }

    .navbar {
        display: flex;
        justify-content: space-around;
        background-color: #141526;
        padding: 15px;
        border-radius: 5px;
    }

    .navbar a {
        color: white;
        text-decoration: none;
        padding: 10px 20px;
    }

    .navbar a:hover {
        background-color: #334086;
        border-radius: 5px;
    }

    .card-container {
        display: flex;
        justify-content: center;
        align-items: center;
        gap: 20px;
        min-height: 400px;
    }

    .card {
        background-color: #e3f2fd;
        padding: 20px;
        width: 250px;
        text-align: center;
        border-radius: 10px;
    }
       
    .gallery {
        display: flex;
        flex-wrap: wrap;
        gap: 15px;
        justify-content: center;
    }

    .gallery img {
        width: 250px;
        height: 350px;
        object-fit: cover;
        border-radius: 8px;
    }

    .center-box {
        display: flex;
        justify-content: center;
        align-items: center;
        height: 200px;
        background-color: #ddd;
        border-radius: 10px;
    }

    .center-item {
        background-color: #141526;
        color: white;
        padding: 30px;
        border-radius: 10px;
    }

    .blog {
        display: grid;
        grid-template-columns: 2fr 1fr;
        gap: 20px;
    }

    .main-content {
        background-color: #e8f5e9;
        padding: 20px;
    }

        .sidebar {
            background-color: #fff3cd;
            padding: 20px;
        }

        .products {
            display: grid;
            grid-template-columns: repeat(4, 1fr);
            gap: 15px;
        }

        .product {
            background-color: #eeeeee;
            padding: 20px;
            text-align: center;
            border-radius: 8px;
        }

        .calendar {
            display: grid;
            grid-template-columns: repeat(7, 1fr);
            gap: 5px;
        }

        .day {
            background-color: #e3f2fd;
            padding: 20px;
            text-align: center;
            border: 1px solid #ccc;
        }

        .day-name {
            background-color: #334086;
            color: white;
            font-weight: bold;
        }

        .span-grid {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            grid-template-rows: 100px 100px;
            gap: 10px;
        }

        .span-item {
            background-color: #141526;
            color: white;
            display: flex;
            justify-content: center;
            align-items: center;

            grid-row: span 2;
        }

        .normal-item {
            background-color: #a3a8d8;
            display: flex;
            justify-content: center;
            align-items: center;
        }

        @media (max-width: 700px) {

            .blog {
                grid-template-columns: 1fr;
            }
            .products {
                grid-template-columns: repeat(2, 1fr);
            }
            .day {
                padding: 10px;
            }
            .card-container {
                flex-wrap: wrap;
            }
        }

    </style>
</head>

